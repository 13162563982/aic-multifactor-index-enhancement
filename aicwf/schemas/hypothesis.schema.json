{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicwf.local/schemas/hypothesis.schema.json",
  "title": "Research hypothesis specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thesis",
    "factor_weights",
    "rebalance",
    "constraints",
    "falsification",
    "information_cutoff",
    "source_limits"
  ],
  "properties": {
    "thesis": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000,
      "description": "A falsifiable statement about which compensated factors should earn excess return versus the benchmark."
    },
    "factor_weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": -1.0, "maximum": 1.0}
    },
    "rebalance": {
      "type": "string",
      "enum": ["monthly", "quarterly"]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_weight", "max_active_weight", "te_target", "turnover_limit"],
      "properties": {
        "max_weight": {"type": "number", "minimum": 0.005, "maximum": 0.10},
        "max_active_weight": {"type": "number", "minimum": 0.001, "maximum": 0.05},
        "te_target": {"type": "number", "minimum": 0.01, "maximum": 0.12},
        "turnover_limit": {"type": "number", "minimum": 0.05, "maximum": 0.60}
      }
    },
    "falsification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 10, "maxLength": 500}
    },
    "information_cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3, "maxLength": 300}
    }
  }
}
